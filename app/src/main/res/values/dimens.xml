<?xml version="1.0" encoding="utf-8"?>
<!--
    معيار أحجام النصوص في ITN Secure Browser
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    جميع الأحجام تتبع مبدأ قوى العدد 2:
      text_xs  =  8sp  ← عداد التبويبات (رقم صغير داخل أيقونة)
      text_sm  = 16sp  ← نصوص ثانوية، عناوين التبويبات، قوائم
      text_md  = 32sp  ← عناوين رئيسية (محجوز للاستخدام المستقبلي)

    القاعدة: لا تُكتب أي قيمة textSize مباشرة في XML أو Kotlin —
    يجب دائماً الإشارة إلى @dimen/text_* من هذا الملف.
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-->
<resources>
    <!-- أحجام النصوص -->
    <dimen name="text_xs">8sp</dimen>
    <dimen name="text_sm">16sp</dimen>
    <dimen name="text_md">32sp</dimen>
</resources>
