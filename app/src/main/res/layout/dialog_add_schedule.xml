<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Days label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_days_label"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:paddingBottom="8dp" />

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbSaturday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_saturday"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/cbSunday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_sunday"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbMonday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_monday"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/cbTuesday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_tuesday"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbWednesday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_wednesday"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/cbThursday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_thursday"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Row 4 -->
        <CheckBox
            android:id="@+id/cbFriday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/day_friday"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333355"
            android:layout_marginBottom="16dp" />

        <!-- Time label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_time_label"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:paddingBottom="12dp" />

        <!-- Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_from"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingRight="8dp" />

            <TextView
                android:id="@+id/btnFromTime"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="#252545"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_to"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingLeft="16dp"
                android:paddingRight="8dp" />

            <TextView
                android:id="@+id/btnToTime"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="#252545"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_time_hint"
            android:textColor="#555577"
            android:textSize="11sp"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>
