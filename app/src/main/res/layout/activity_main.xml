<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_toolbar">

    <!-- ── شريط العنوان (أعلى) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_toolbar"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textUri"
            android:singleLine="true"
            android:hint="@string/hint_search"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:selectAllOnFocus="true" />

        <ImageButton
            android:id="@+id/btnRefreshStop"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:contentDescription="Refresh or stop" />

    </LinearLayout>

    <!-- ── شريط التحميل ── -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/bg_toolbar" />

    <!-- ── WebView ── -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── شريط التنقل السفلي ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_tab_bar"
        android:gravity="center_vertical">

        <!-- زر الخلف/أمام — مثلث -->
        <FrameLayout
            android:id="@+id/btnNavGroup"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center">

            <com.itn.securebrowser.TriangleNavView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Back" />

        </FrameLayout>

        <!-- زر الرئيسية — دائرة -->
        <FrameLayout
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center">

            <com.itn.securebrowser.CircleView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Home" />

        </FrameLayout>

        <!-- زر التبويبات — مربع مع عداد -->
        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center">

            <com.itn.securebrowser.TabsSquareView
                android:id="@+id/tabsSquare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Tabs" />

        </FrameLayout>

        <!-- زر المزيد -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:src="@drawable/ic_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:contentDescription="More" />

    </LinearLayout>

    <!-- شريط التبويبات القديم — مخفي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/tabsScrollView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnNewTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:src="@drawable/ic_add"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="New tab" />

    </LinearLayout>

</LinearLayout>
