<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_toolbar">

    <!-- ── شريط العنوان (أعلى) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_toolbar"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textUri"
            android:singleLine="true"
            android:hint="@string/hint_search"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:selectAllOnFocus="true" />

        <ImageButton
            android:id="@+id/btnRefreshStop"
            style="@style/NavButton"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/cd_refresh_stop" />

    </LinearLayout>

    <!-- ── شريط التحميل ── -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/bg_toolbar" />

    <!-- ── WebView ── -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── شريط التنقل السفلي ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_tab_bar"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/NavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:src="@drawable/ic_back"
            android:alpha="0.35"
            android:contentDescription="@string/cd_back" />

        <ImageButton
            android:id="@+id/btnForward"
            style="@style/NavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:src="@drawable/ic_forward"
            android:alpha="0.35"
            android:contentDescription="@string/cd_forward" />

        <ImageButton
            android:id="@+id/btnHome"
            style="@style/NavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/cd_home" />

        <ImageButton
            android:id="@+id/btnTabs"
            style="@style/NavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:src="@drawable/ic_tabs"
            android:contentDescription="@string/cd_tabs" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/NavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/cd_more" />

    </LinearLayout>

    <!-- شريط التبويبات القديم — مخفي، يُبقي الكود يعمل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/tabsScrollView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnNewTab"
            style="@style/NavButton.Accent"
            android:layout_width="0dp"
            android:layout_weight="0"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/cd_new_tab" />

    </LinearLayout>

</LinearLayout>
