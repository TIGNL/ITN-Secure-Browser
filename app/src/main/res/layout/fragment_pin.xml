<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0F0F1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐"
        android:textSize="48sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tab_pin"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/pinStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_status_none"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnSetPin"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="@string/btn_set_pin"
        android:backgroundTint="@color/accent"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnClearPin"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_clear_pin"
        android:backgroundTint="#2A2A4A"
        android:textColor="#888888"
        android:textSize="15sp"
        android:visibility="gone" />

</LinearLayout>
