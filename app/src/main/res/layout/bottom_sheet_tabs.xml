<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#444466" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/sheetTabCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="التبويبات"
            android:textColor="#888888"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A4A"
        android:layout_marginBottom="4dp" />

    <!-- Tabs list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheetTabsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A4A" />

    <!-- زر تبويبة جديدة — أيقونة فقط، 64dp متناسق مع الشريط السفلي -->
    <ImageButton
        android:id="@+id/btnSheetNewTab"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:src="@drawable/ic_add"
        android:tint="@color/accent"
        android:background="?attr/selectableItemBackground"
        android:padding="18dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="تبويبة جديدة" />

</LinearLayout>
