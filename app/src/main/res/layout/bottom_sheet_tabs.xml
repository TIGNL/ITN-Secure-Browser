<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <!-- الهيكل المشترك: Handle + Header + Divider -->
    <include
        layout="@layout/bottom_sheet_base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Tabs list — layout_weight="1" يأخذ المساحة المتبقية -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheetTabsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A4A" />

    <!-- زر تبويبة جديدة — 64dp موحّد مع بقية الصفوف -->
    <ImageButton
        android:id="@+id/btnSheetNewTab"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:src="@drawable/ic_add"
        android:tint="@color/accent"
        android:background="?attr/selectableItemBackground"
        android:padding="18dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="تبويبة جديدة" />

</LinearLayout>
